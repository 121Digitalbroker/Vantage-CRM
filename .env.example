# true = dummy leads in browser (assignment always works). false = Supabase only (set RLS in supabase-rls-leads.sql).
VITE_USE_DEMO_LEADS=true
VITE_USE_DEMO_USERS=false

# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Express server (`npm run server` / Coolify backend) ---
# Reuse the same Supabase project URL. For Meta webhooks, prefer the service role on the server only (never VITE_*).
# PORT=4000
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_ANON_KEY=your-anon-key-here

# --- Meta Lead Ads → Graph API (server only; do not expose in the browser) ---
# Webhook callback URL in Meta: https://YOUR-BACKEND-DOMAIN/api/meta-webhook
# META_APP_SECRET=your-app-secret
# META_VERIFY_TOKEN=any-long-random-string-you-choose
# META_PAGE_ACCESS_TOKEN=page-access-token-with-leads_retrieval
# Optional: META_GRAPH_VERSION=v21.0
# Dev only (disables signature check): META_SKIP_SIGNATURE_VERIFY=true
